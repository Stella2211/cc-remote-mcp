# cc-remote-mcp クライアントの設定。client/.env にコピーして使う（.env はコミットしない）。
# パスの区切りは PATH と同じ（macOS / Linux は :、Windows は ;）。~ はホームディレクトリ。

# Worker の端末用の入口
CC_REMOTE_MCP_URL=wss://link.cc-remote-mcp.example.com/connect

# 端末名とトークン。`bun run device init <端末名>` が書き込む（手で書かない）
DEVICE_NAME=
DEVICE_TOKEN=

# 一覧・起動を許すディレクトリ（必須。この外は見えない・起動できない）
# 例（macOS）: ALLOWED_ROOTS=~/Documents/Programs:~/work
# 例（Windows）: ALLOWED_ROOTS=C:\Users\me\Programs;D:\work
ALLOWED_ROOTS=

# 起動ブロックディレクトリ。この中は一覧にも出さず、起動もしない（任意）
# ~/.ssh・~/.aws・~/.claude などの資格情報の置き場は、書かなくても常にブロックする
BLOCKED_DIRS=

# . で始まるディレクトリを対象外にする（既定 true）
HIDE_DOT_DIRS=true

# 同時に動かせるセッションの数（rc と対話セッションの合計。1〜16、既定 4）
MAX_SESSIONS=4

# 遠隔から起動したセッションの既定の権限モード（default / acceptEdits / plan / auto、空なら claude の既定）
DEFAULT_PERMISSION_MODE=

# claude の実行ファイルのフルパス（任意。空なら PATH から探す。Windows は claude.exe を指定）
CLAUDE_BIN=

# tmux の実行ファイルのフルパス（任意。空なら PATH と /opt/homebrew/bin・/usr/local/bin・/usr/bin から探す）
# 対話セッション（start_session / send_input）に使う。無ければ対話セッションだけが使えない（rc の起動はそのまま使える）
TMUX_BIN=

# 任意：link. ホストを Cloudflare Access のサービストークンでも守る場合だけ設定する
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
